{
  "rewrites": [
    { "source": "/", "destination": "https://rajichalla11.github.io/wednesday-hof/" },
    { "source": "/:path*", "destination": "https://rajichalla11.github.io/wednesday-hof/:path*" }
  ],
  "headers": [
    { "source": "/((?!api/).*)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" } ] }
  ]
}
