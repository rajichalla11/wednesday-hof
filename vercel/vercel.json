{
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/page"
    },
    {
      "source": "/index.html",
      "destination": "/api/page"
    },
    {
      "source": "/:path((?!api/).*)",
      "destination": "https://rajichalla11.github.io/wednesday-hof/:path"
    }
  ],
  "headers": [
    {
      "source": "/((?!api/).+)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
